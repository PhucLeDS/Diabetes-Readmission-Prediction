# Local Python and Jupyter files
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/

# Editor and system files
/.idea/
/.vscode/
.DS_Store
Thumbs.db

# Local configuration and credentials
.env
.env.*
!.env.example
*.pem
*.key

# Java build files and temporary artifacts
*.class
*.tmp
*.temp

# Patient-level data and generated datasets
/data/raw/*
!/data/raw/.gitkeep
/data/interim/*
!/data/interim/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/data/weka/*
!/data/weka/.gitkeep
/outputs/preparation/*
!/outputs/preparation/.gitkeep

# Generated EDA artifacts
/outputs/tables/eda/*
/outputs/figures/eda/*
